---
import type { GetStaticPaths } from 'astro';
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Label from '../../components/Label.astro';
import RecipeBookCover from '../../components/RecipeBookCover.astro';
import { productLabel } from '../../lib/products';
import { batchFromMade } from '../../lib/label';
import { href } from '../../lib/url';

export const getStaticPaths = (async () => {
  const recipes = await getCollection('recipes');
  return recipes.map((recipe) => ({ params: { slug: recipe.id }, props: { recipe } }));
}) satisfies GetStaticPaths;

const { recipe } = Astro.props;
const product = await getEntry(recipe.data.product);
if (!product) throw new Error(`Recipe ${recipe.id} names an unknown product`);
const { Content } = await render(recipe);
const lastMade = batchFromMade(product.data.made, 'Not made yet');
const lastMadeDisplay = lastMade.charAt(0) + lastMade.slice(1).toLowerCase(); // "AUGUST 2026" → "August 2026"
---

<Base
  title={`${recipe.data.title} recipe · Old Ma Main's`}
  current="kitchen"
  footerRule
  description={`Old Ma Main's recipe for ${recipe.data.title.toLowerCase()}.`}
>
  <main class="container page">
    <div class="stack head">
      <nav aria-label="Breadcrumb" class="eyebrow breadcrumb" data-print="hide">
        <a href={href('/recipes/')}>RECIPES</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{recipe.data.title.toUpperCase()}</span>
      </nav>
      <h1 class="display">{recipe.data.title}</h1>
      <p class="prose-width">{recipe.data.intro}</p>
      <dl class="facts">
        <div>
          <dt class="eyebrow">MAKES</dt>
          <dd>{recipe.data.makes}</dd>
        </div>
        <div>
          <dt class="eyebrow">TAKES</dt>
          <dd>{recipe.data.takes}</dd>
        </div>
        <div>
          <dt class="eyebrow">LAST MADE</dt>
          <dd>{lastMadeDisplay}</dd>
        </div>
      </dl>
    </div>

    <div class="body">
      <div class="stack side">
        <section class="stack ingredients">
          <h2>Ingredients</h2>
          <ul>
            {
              recipe.data.ingredients.map((item) => (
                <li>
                  <label>
                    <input type="checkbox" />
                    <span>{item}</span>
                  </label>
                </li>
              ))
            }
          </ul>
        </section>
        <section class="stack jar" data-print="hide">
          <p class="eyebrow">THE JAR THIS MAKES</p>
          <Label {...productLabel(product)} maxWidth={280} />
          <a href={href('/labels/')} class="text-link">MAKE THIS LABEL</a>
        </section>
      </div>

      <div class="stack main">
        <section class="stack method">
          <h2>Method</h2>
          <Content />
        </section>
        <div class="boxed tip">
          <p class="eyebrow">OLD MA'S TIP</p>
          <p>{recipe.data.tip}</p>
        </div>
        <div class="btn-row" data-print="hide">
          <button type="button" class="btn" id="book-toggle" data-recipe={recipe.id} aria-pressed="false">
            ADD TO THE RECIPE BOOK
          </button>
          <button type="button" class="btn" id="print-recipe">PRINT THIS RECIPE</button>
        </div>
      </div>
    </div>
  </main>

  <section class="ink-band" data-print="hide">
    <div class="container book">
      <div class="cover">
        <RecipeBookCover />
      </div>
      <div class="stack book-copy">
        <p class="eyebrow">THE RECIPE BOOK</p>
        <h2 class="section-title">Every recipe, bound together</h2>
        <p class="prose-width">
          Recipes saved here are collected as they come. When there are enough, they become a printed book.
        </p>
        <p role="status" class="book-count" id="book-count">No recipes in the book yet</p>
      </div>
    </div>
  </section>
</Base>

<script>
  import { readBook, toggleInBook, bookCountText } from '../../lib/recipe-book';

  const toggle = document.getElementById('book-toggle') as HTMLButtonElement;
  const count = document.getElementById('book-count')!;
  const id = toggle.dataset.recipe!;

  function show(book: string[]) {
    const inBook = book.includes(id);
    toggle.setAttribute('aria-pressed', String(inBook));
    toggle.textContent = inBook ? 'IN THE RECIPE BOOK' : 'ADD TO THE RECIPE BOOK';
    count.textContent = bookCountText(book.length);
  }

  show(readBook());
  toggle.addEventListener('click', () => show(toggleInBook(id)));
  document.getElementById('print-recipe')!.addEventListener('click', () => window.print());
</script>

<style>
  .page {
    padding-block: clamp(24px, 4vw, 48px) clamp(32px, 6vw, 72px);
    display: flex;
    flex-direction: column;
    gap: clamp(28px, 4vw, 48px);
  }

  .head {
    gap: 16px;
  }

  .breadcrumb {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 8px;
  }

  .breadcrumb a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
  }

  .facts {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    border-top: var(--rule-frame) solid var(--ink);
    border-bottom: var(--rule-fine) solid var(--ink);
  }

  .facts > div {
    flex: 1 1 160px;
    padding: 12px 16px 12px 0;
    display: flex;
    flex-direction: column;
  }

  .facts dd {
    margin: 0;
  }

  .body {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 48px;
  }

  .side {
    flex: 1 1 280px;
    max-width: 380px;
    min-width: 0;
    gap: 32px;
  }

  .main {
    flex: 2 1 420px;
    min-width: 0;
    gap: 32px;
  }

  h2 {
    font-size: 28px;
    line-height: 1.2;
  }

  .ingredients {
    gap: 8px;
  }

  .ingredients ul {
    list-style: none;
    padding: 0;
    border-bottom: var(--rule-fine) solid var(--ink);
  }

  .ingredients label {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: var(--tap);
    border-top: var(--rule-fine) solid var(--ink);
    cursor: pointer;
  }

  .ingredients input {
    width: 22px;
    height: 22px;
    margin: 0;
    flex: none;
    accent-color: var(--ink);
  }

  .ingredients input:checked + span {
    text-decoration: line-through;
    text-decoration-thickness: 1.5px;
  }

  .jar {
    gap: 12px;
  }

  .method {
    gap: 20px;
  }

  /* The method is the Markdown body: an ordered list, numbered in ink squares. */
  .method :global(ol) {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 20px;
    counter-reset: step;
  }

  .method :global(li) {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    counter-increment: step;
    padding-top: 8px;
    max-width: calc(34em + 64px);
  }

  .method :global(li)::before {
    content: counter(step);
    flex: 0 0 48px;
    height: 48px;
    margin-top: -8px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--ink);
    color: var(--paper);
    font-weight: 700;
    font-size: 22px;
  }

  .tip {
    padding: 16px 20px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  /* recipe book band */
  .book {
    padding-block: clamp(40px, 7vw, 80px);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 48px;
  }

  .cover {
    flex: 0 1 300px;
    width: 100%;
    max-width: 300px;
    min-width: 0;
  }

  .book-copy {
    flex: 1 1 340px;
    min-width: 0;
    align-items: flex-start;
    gap: 16px;
  }

  .book-count {
    border-block: var(--rule-fine) solid var(--paper);
    padding: 8px 0;
    font-weight: 700;
    letter-spacing: 0.06em;
  }

  @media print {
    .page {
      padding: 0;
    }

    .method :global(li)::before {
      print-color-adjust: exact;
      -webkit-print-color-adjust: exact;
    }
  }
</style>
