---
import Base from '../layouts/Base.astro';
import Label from '../components/Label.astro';
import { getProducts } from '../lib/products';
import { BASKETS, DEFAULT_BASKET, MADE_WITH_MAX, MONTHS, PRODUCT_MAX_CHARS, SHEET, isBasketId, isTooLong } from '../lib/label';

const products = await getProducts();

/** Presets for START FROM. Products not made yet take the current month in the browser. */
const presets = [
  ...products.map((p) => {
    const [year, month] = p.data.made?.split('-') ?? [];
    return {
      id: p.id,
      label: p.data.kind,
      line1: p.data.line1.toUpperCase(),
      line2: p.data.line2.toUpperCase(),
      phrase: p.data.phrase.toUpperCase(),
      basket: p.data.basket as string | null,
      month: month ? MONTHS[Number(month) - 1] : null,
      year: year ?? null,
    };
  }),
  {
    id: 'new',
    label: 'New product',
    line1: 'YOUR PRODUCT',
    line2: '',
    phrase: 'YOUR PHRASE HERE',
    basket: DEFAULT_BASKET as string | null,
    month: null,
    year: null,
  },
];

const start = presets.find((p) => p.id === 'strawberry-jam') ?? presets[0];
const startMonth = start.month ?? 'August';
const startYear = start.year ?? '2026';
const startBatch = `${startMonth} ${startYear}`.toUpperCase();
const startBasket = isBasketId(start.basket) ? start.basket : DEFAULT_BASKET;
const perSheet = SHEET.cols * SHEET.rows;
---

<Base title="Label maker · Old Ma Main's" current="labels" description="Make a jar label in the Old Ma Main's style.">
  <main class="container page" data-print="hide">
    <div class="stack intro">
      <p class="eyebrow">LABEL MAKER</p>
      <h1>Make a label for the jar</h1>
      <p class="prose-width">
        Pick a product, change the words and print it. The frame, type and ribbon stay the same, so every jar looks like
        Old Ma's.
      </p>
    </div>

    <div class="workbench">
      <div class="preview">
        <Label
          id="label-preview"
          line1={start.line1}
          line2={start.line2}
          batch={startBatch}
          phrase={start.phrase}
          basket={startBasket}
        />
      </div>

      <div class="double-frame controls">
        <form id="label-form" class="stack form">
          <fieldset class="stack">
            <legend class="eyebrow">START FROM</legend>
            <div class="presets">
              {
                presets.map((p) => (
                  <button
                    type="button"
                    class="btn btn--small"
                    data-preset={p.id}
                    aria-pressed={p.id === start.id ? 'true' : 'false'}
                  >
                    {p.label}
                  </button>
                ))
              }
            </div>
          </fieldset>

          <div class="row">
            <div class="field grow">
              <label for="line1">FIRST LINE</label>
              <input id="line1" name="line1" type="text" autocomplete="off" value={start.line1} />
            </div>
            <div class="field grow">
              <label for="line2">SECOND LINE <span class="optional">(optional)</span></label>
              <input id="line2" name="line2" type="text" autocomplete="off" value={start.line2} />
            </div>
          </div>

          <div role="status" class="warning-region">
            <p id="too-long" class="boxed warning" hidden={!isTooLong(start)}>
              That name is too long to sit inside the frame. Keep each line to {PRODUCT_MAX_CHARS} letters or fewer.
            </p>
          </div>

          <div class="field">
            <label for="basket">BASKET</label>
            <select id="basket" name="basket">
              {BASKETS.map((b) => <option value={b.id} selected={b.id === startBasket}>{b.name}</option>)}
            </select>
          </div>

          <div class="row">
            <div class="field month">
              <label for="month">MONTH MADE</label>
              <select id="month" name="month">
                {MONTHS.map((m) => <option value={m} selected={m === startMonth}>{m}</option>)}
              </select>
            </div>
            <div class="field year">
              <label for="year">YEAR</label>
              <input id="year" name="year" type="text" inputmode="numeric" maxlength="4" value={startYear} />
            </div>
          </div>

          <div class="field">
            <label for="phrase">HOW IS IT MADE?</label>
            <input id="phrase" name="phrase" type="text" autocomplete="off" value={start.phrase} aria-describedby="phrase-hint" />
            <p id="phrase-hint" class="hint">A short phrase, under four words. MADE WITH LOVE is added for you.</p>
          </div>

          <div class="field">
            <label for="collab">MADE WITH <span class="optional">(optional)</span></label>
            <input
              id="collab"
              name="collab"
              type="text"
              autocomplete="off"
              placeholder="e.g. THE JUNIOR ANDERSONS"
              aria-describedby="collab-hint"
            />
            <p id="collab-hint" class="hint">
              For a batch made with someone else. WITH is added for you, on a small arc under OLD MA MAIN&rsquo;S.
              Leave it empty when Old Ma made the batch alone.
            </p>
            <div role="status">
              <p id="collab-trimmed" class="boxed warning" hidden>
                Too long for the arc ({MADE_WITH_MAX} letters with WITH), so the label shows <strong id="collab-shown"></strong>.
              </p>
            </div>
          </div>

          <div class="btn-row">
            <button type="button" id="download" class="btn btn--solid">DOWNLOAD PNG</button>
            <button type="button" id="download-pdf" class="btn">DOWNLOAD PDF</button>
            <button type="button" id="print" class="btn">PRINT A SHEET</button>
          </div>
          <p class="hint">
            The PDF and the printed sheet hold {perSheet} labels on one A4 page, {SHEET.cols} across and {SHEET.rows} down.
            Home printers turn the brown ink near-black. That is fine.
          </p>
        </form>
      </div>
    </div>

    <section class="stack keeps">
      <h2>What every label keeps</h2>
      <div class="ruled-grid">
        <div class="ruled-item">
          <p>Everything in capitals</p>
          <p>Type what you like. The label sets it in capitals.</p>
        </div>
        <div class="ruled-item">
          <p>Month and year made</p>
          <p>The batch line says when it was made. Never a best before date.</p>
        </div>
        <div class="ruled-item">
          <p>One size of name</p>
          <p>Every name is set at the size of SEVILLE ORANGE MARMALADE. If a name does not fit, shorten the wording.</p>
        </div>
      </div>
    </section>
  </main>

  <!-- Only shown when printing: a full A4 sheet of labels. -->
  <div
    id="print-sheet"
    class="print-sheet"
    aria-hidden="true"
    data-count={perSheet}
    style={`--sheet-cols: ${SHEET.cols}; --sheet-gap: ${SHEET.gap}mm; --sheet-margin: ${SHEET.margin}mm; --label-w: ${SHEET.labelW}mm; --label-h: ${SHEET.labelH}mm;`}
  >
  </div>

  <script type="application/json" id="label-presets" set:html={JSON.stringify(presets)} />
</Base>

<script>
  import { jsPDF } from 'jspdf';
  import {
    renderLabelSvg,
    isTooLong,
    isBasketId,
    madeWith,
    basketUrl,
    ORNAMENTS,
    DEFAULT_BASKET,
    MONTHS,
    SHEET,
    LABEL_WIDTH,
    LABEL_HEIGHT,
    type LabelText,
  } from '../lib/label';
  import caslon400 from '@fontsource/libre-caslon-text/files/libre-caslon-text-latin-400-normal.woff2?url';
  import caslon700 from '@fontsource/libre-caslon-text/files/libre-caslon-text-latin-700-normal.woff2?url';
  import fell400 from '@fontsource/im-fell-english-sc/files/im-fell-english-sc-latin-400-normal.woff2?url';

  type Preset = {
    id: string;
    line1: string;
    line2: string;
    phrase: string;
    basket: string | null;
    month: string | null;
    year: string | null;
  };

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;

  const presets: Preset[] = JSON.parse($('label-presets').textContent ?? '[]');
  const preview = $('label-preview');
  const sheet = $('print-sheet');
  const tooLong = $('too-long');
  const collabTrimmed = $('collab-trimmed');
  const collabShown = $('collab-shown');
  const inputs = {
    line1: $<HTMLInputElement>('line1'),
    line2: $<HTMLInputElement>('line2'),
    basket: $<HTMLSelectElement>('basket'),
    month: $<HTMLSelectElement>('month'),
    year: $<HTMLInputElement>('year'),
    phrase: $<HTMLInputElement>('phrase'),
    collab: $<HTMLInputElement>('collab'),
  };
  const presetButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-preset]'));

  function current(): LabelText {
    return {
      line1: inputs.line1.value,
      line2: inputs.line2.value,
      batch: `${inputs.month.value} ${inputs.year.value}`,
      phrase: inputs.phrase.value,
      collab: inputs.collab.value,
      basket: isBasketId(inputs.basket.value) ? inputs.basket.value : DEFAULT_BASKET,
    };
  }

  function render() {
    const text = current();
    preview.innerHTML = renderLabelSvg(text, { idPrefix: 'preview' });
    tooLong.hidden = !isTooLong(text);
    // A made-with name too long for the arc loses whole words; say what the label shows.
    const shown = madeWith(text.collab);
    const typed = (text.collab ?? '').trim().replace(/\s+/g, ' ').toUpperCase().replace(/^(WITH |& )/, '');
    collabTrimmed.hidden = !typed || shown.endsWith(typed);
    collabShown.textContent = shown;
  }

  function pickPreset(id: string) {
    const p = presets.find((x) => x.id === id);
    if (!p) return;
    const now = new Date();
    inputs.line1.value = p.line1;
    inputs.line2.value = p.line2;
    inputs.phrase.value = p.phrase;
    inputs.basket.value = p.basket ?? DEFAULT_BASKET;
    inputs.month.value = p.month ?? MONTHS[now.getMonth()];
    inputs.year.value = p.year ?? String(now.getFullYear());
    for (const b of presetButtons) b.setAttribute('aria-pressed', String(b.dataset.preset === id));
    render();
  }

  for (const b of presetButtons) b.addEventListener('click', () => pickPreset(b.dataset.preset!));
  for (const el of Object.values(inputs)) {
    el.addEventListener('input', render);
    el.addEventListener('change', render);
  }

  // ---- exports: everything embedded, so the label needs nothing from the network ----

  async function asDataUrl(url: string): Promise<string> {
    const blob = await (await fetch(url)).blob();
    return new Promise((resolve, reject) => {
      const reader = new FileReader();
      reader.onload = () => resolve(reader.result as string);
      reader.onerror = reject;
      reader.readAsDataURL(blob);
    });
  }

  let embeddedFonts: Promise<string> | undefined;
  function fontFaces(): Promise<string> {
    embeddedFonts ??= Promise.all([caslon400, caslon700, fell400].map(asDataUrl)).then(
      ([c4, c7, f4]) => `<style>
@font-face{font-family:'Libre Caslon Text';font-weight:400;src:url(${c4}) format('woff2')}
@font-face{font-family:'Libre Caslon Text';font-weight:700;src:url(${c7}) format('woff2')}
@font-face{font-family:'IM Fell English SC';font-weight:400;src:url(${f4}) format('woff2')}
</style>`,
    );
    return embeddedFonts;
  }

  /** Images fetched once and kept as data: URIs. */
  const embedded = new Map<string, Promise<string>>();
  function embed(url: string): Promise<string> {
    if (!embedded.has(url)) embedded.set(url, asDataUrl(url));
    return embedded.get(url)!;
  }

  /** Draw the label onto a canvas `width` pixels wide (height follows at 2:3). */
  async function rasterise(text: LabelText, width: number): Promise<HTMLCanvasElement> {
    const height = Math.round((width * LABEL_HEIGHT) / LABEL_WIDTH);
    const [fonts, basket, corner, laurel] = await Promise.all([
      fontFaces(),
      embed(basketUrl(text.basket ?? DEFAULT_BASKET)),
      embed(ORNAMENTS.corner),
      embed(ORNAMENTS.laurel),
    ]);
    const svg = renderLabelSvg(text, {
      idPrefix: 'export',
      width,
      height,
      extraDefs: fonts,
      hrefs: { basket, corner, laurel },
    });
    const img = new Image();
    const url = URL.createObjectURL(new Blob([svg], { type: 'image/svg+xml' }));
    try {
      await new Promise<void>((resolve, reject) => {
        img.onload = () => resolve();
        img.onerror = () => reject(new Error('Could not draw the label'));
        img.src = url;
      });
      // Give the browser a beat to apply the embedded fonts before rasterising.
      await new Promise((r) => setTimeout(r, 50));
      const canvas = document.createElement('canvas');
      canvas.width = width;
      canvas.height = height;
      canvas.getContext('2d')!.drawImage(img, 0, 0);
      return canvas;
    } finally {
      URL.revokeObjectURL(url);
    }
  }

  function fileName(text: LabelText, ext: string) {
    const slug = [text.line1, text.line2, madeWith(text.collab), text.batch]
      .join(' ')
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/^-|-$/g, '');
    return `old-ma-mains-${slug || 'label'}.${ext}`;
  }

  function save(blob: Blob, name: string) {
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = name;
    a.click();
    setTimeout(() => URL.revokeObjectURL(a.href), 1000);
  }

  /** Wire an export button: progress on the button, a plain message if it fails. */
  function exporter(button: HTMLButtonElement, what: string, run: (text: LabelText) => Promise<void>) {
    button.addEventListener('click', async () => {
      const original = button.textContent;
      button.disabled = true;
      button.textContent = 'PREPARING…';
      try {
        await run(current());
      } catch (err) {
        console.error(err);
        alert(`Sorry, the ${what} could not be made in this browser. Try printing a sheet instead.`);
      } finally {
        button.disabled = false;
        button.textContent = original;
      }
    });
  }

  // One label at 1536 × 2304: plenty for print.
  exporter($<HTMLButtonElement>('download'), 'PNG', async (text) => {
    const canvas = await rasterise(text, 1536);
    const png = await new Promise<Blob | null>((r) => canvas.toBlob(r, 'image/png'));
    if (!png) throw new Error('Could not make the PNG');
    save(png, fileName(text, 'png'));
  });

  // A full A4 page of the same label, 3 across and 4 down.
  exporter($<HTMLButtonElement>('download-pdf'), 'PDF', async (text) => {
    const canvas = await rasterise(text, 1024); // 1024 × 1536: about 590 dpi at sheet size
    const image = canvas.toDataURL('image/png');
    const pdf = new jsPDF({ unit: 'mm', format: 'a4', orientation: 'portrait' });
    pdf.setProperties({ title: `Old Ma Main's labels: ${[text.line1, text.line2].filter(Boolean).join(' ')}` });
    for (let row = 0; row < SHEET.rows; row++) {
      for (let col = 0; col < SHEET.cols; col++) {
        const x = SHEET.left + col * (SHEET.labelW + SHEET.gap);
        const y = SHEET.margin + row * (SHEET.labelH + SHEET.gap);
        // One alias for every cell, so the image is stored in the PDF once.
        pdf.addImage(image, 'PNG', x, y, SHEET.labelW, SHEET.labelH, 'label', 'FAST');
      }
    }
    save(pdf.output('blob'), fileName(text, 'pdf'));
  });

  // ---- print a sheet: the same 3 × 4 grid, through the browser ----

  function fillSheet() {
    const text = current();
    sheet.innerHTML = Array.from(
      { length: Number(sheet.dataset.count) || 12 },
      (_, i) => `<div class="sheet-label">${renderLabelSvg(text, { idPrefix: `sheet${i}`, accessible: false })}</div>`,
    ).join('');
  }

  window.addEventListener('beforeprint', fillSheet);
  $('print').addEventListener('click', () => {
    fillSheet();
    window.print();
  });
</script>

<style>
  .page {
    padding-block: clamp(28px, 5vw, 56px);
    display: flex;
    flex-direction: column;
    gap: clamp(28px, 4vw, 48px);
  }

  .intro {
    gap: 12px;
  }

  h1 {
    font-size: clamp(34px, 4.6vw, 56px);
    line-height: 1.1;
  }

  .workbench {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 48px;
  }

  .preview {
    flex: 1 1 340px;
    min-width: 0;
    display: flex;
    justify-content: center;
  }

  .controls {
    flex: 1 1 380px;
    min-width: 0;
  }

  .form {
    padding: clamp(16px, 3vw, 28px);
    gap: 24px;
  }

  fieldset {
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
    gap: 10px;
  }

  legend {
    padding: 0;
    margin-bottom: 10px;
  }

  .presets {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  /* Bottom-align side-by-side fields so their inputs share a line even if one label wraps. */
  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 16px;
  }

  .grow {
    flex: 1 1 180px;
  }

  .optional {
    font-weight: 400;
    letter-spacing: 0.02em;
  }

  .month {
    flex: 2 1 160px;
  }

  .year {
    flex: 1 1 110px;
  }

  /* Keep the live region in the tree so changes are announced, but take back the gap while empty. */
  .warning-region:has(> [hidden]) {
    margin-top: -24px;
  }

  .warning {
    padding: 10px 12px;
    font-size: 16px;
  }

  .btn:disabled {
    cursor: progress;
    opacity: 0.8;
  }

  .keeps {
    gap: 20px;
  }

  .keeps h2 {
    font-size: clamp(26px, 3.4vw, 36px);
    line-height: 1.15;
  }

  /* print sheet: hidden on screen, a full A4 page of labels when printing */
  .print-sheet {
    display: none;
  }

  @page {
    size: A4;
    margin: 0;
  }

  @media print {
    .print-sheet {
      display: grid;
      grid-template-columns: repeat(var(--sheet-cols), var(--label-w));
      gap: var(--sheet-gap);
      justify-content: center;
      padding-top: var(--sheet-margin);
    }

    .print-sheet :global(.sheet-label) {
      width: var(--label-w);
      height: var(--label-h);
      break-inside: avoid;
    }
  }
</style>
