---
import Base from '../layouts/Base.astro';
import Label from '../components/Label.astro';
import { getProducts, productLabel } from '../lib/products';
import { batchFromMade } from '../lib/label';
import { href } from '../lib/url';
import { Image } from 'astro:assets';
import oldMaMain from '../assets/old-ma-main.jpg';

const products = await getProducts();
const hero = products.find((p) => p.id === 'strawberry-jam') ?? products[0];

// Made products in date order, then anything not made yet.
const timeline = [
  ...products
    .filter((p) => p.data.made)
    .sort((a, b) => a.data.made!.localeCompare(b.data.made!))
    .map((p) => ({ when: batchFromMade(p.data.made), what: p.data.title, next: false })),
  ...products.filter((p) => !p.data.made).map((p) => ({ when: 'NEXT UP', what: p.data.title, next: true })),
];
---

<Base title="Old Ma Main's: small batch preserves" footerNav>
  <main>
    <section class="container hero">
      <div class="stack hero-copy">
        <p class="fell">SMALL BATCH &bull; MADE WITH LOVE</p>
        <h1 class="display">Preserves, cordials and spirits, made by hand from local produce.</h1>
        <p class="prose-width">
          Small batches of marmalade, jelly, jam, cordial and crab apple gin. Local fruit and flowers, named plainly on
          every label.
        </p>
        <div class="btn-row">
          <a href="#range" class="btn btn--solid">SEE THE RANGE</a>
          <a href="#about" class="btn">MEET OLD MA</a>
        </div>
      </div>
      <div class="hero-label">
        <Label {...productLabel(hero)} maxWidth={400} />
      </div>
    </section>

    <section id="range" class="container block">
      <div class="section-head">
        <p class="eyebrow">THE RANGE</p>
        <h2 class="section-title">Five things from the larder</h2>
      </div>
      <div class="shelf" tabindex="0" role="region" aria-label="The range">
        {
          products.map((p) => (
            <article class="stack product">
              <Label {...productLabel(p)} maxWidth={240} />
              <h3>{p.data.title}</h3>
              <p>{p.data.note}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section id="year" class="container block">
      <div class="section-head">
        <p class="eyebrow">BATCH BY BATCH</p>
        <h2 class="section-title">The year in jars</h2>
      </div>
      <ol class="timeline">
        {
          timeline.map((t) => (
            <li class:list={{ next: t.next }}>
              <p class="when">{t.when}</p>
              <p>{t.what}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section id="about" class="ink-band">
      <div class="container about">
        <figure class="portrait">
          <div class="portrait-inner">
            <Image
              src={oldMaMain}
              alt="A pencil drawing of Old Ma Main at her kitchen table with a colander and a big bowl of fruit, jars on the dresser behind her."
              widths={[400, 700, 1000, 1460]}
              sizes="(min-width: 900px) 440px, 100vw"
              loading="lazy"
            />
          </div>
        </figure>
        <div class="stack about-copy">
          <p class="eyebrow">MEET OLD MA MAIN</p>
          <h2 class="section-title">Old Ma Main, at the kitchen table</h2>
          <p class="prose-width">
            The &ldquo;Old&rdquo; on the label is the recipes, not her. Old Ma Main makes everything at her own kitchen
            table, one pan and one batch at a time, and the finished jars wait in the cupboard under the stairs.
          </p>
          <p class="prose-width">
            Each jar starts with what&rsquo;s ready: elderflowers picked from the hedgerow in May, strawberries at
            midsummer, and local crab apples in autumn, just as the seasons turn. The peel is still cut by hand and the
            jelly still drips through overnight, because some jobs shouldn&rsquo;t be hurried.
          </p>
          <p class="prose-width pull">
            Each jar carries the month it was made, so you know exactly which season you&rsquo;re enjoying.
          </p>
        </div>
      </div>
    </section>

    <section class="container cta-wrap cta-wrap--after-band">
      <div class="cta">
        <div class="stack cta-copy">
          <p class="eyebrow">LABEL MAKER</p>
          <h2 class="cta-title">Need a label? Make one.</h2>
          <p class="prose-width">Pick a product, change the words and print it. Every label keeps the same frame, type and ribbon.</p>
        </div>
        <a href={href('/labels/')} class="btn btn--solid">MAKE A LABEL</a>
      </div>
    </section>
  </main>
</Base>

<style>
  .block {
    padding-block: clamp(24px, 5vw, 56px);
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .block--roomy {
    padding-block: clamp(32px, 6vw, 72px);
  }

  /* hero */
  .hero {
    padding-block: clamp(32px, 6vw, 72px);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 40px;
  }

  .hero-copy {
    flex: 1 1 360px;
    min-width: 0;
    align-items: flex-start;
    gap: 24px;
  }

  .hero-label {
    flex: 1 1 300px;
    min-width: 0;
    display: flex;
    justify-content: center;
  }

  /* range */
  .shelf {
    display: flex;
    gap: 24px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding: 4px 0 16px;
  }

  .product {
    flex: 1 0 200px;
    max-width: 240px;
    scroll-snap-align: start;
    gap: 12px;
  }

  .product h3 {
    font-size: 18px;
    line-height: 1.3;
  }

  .product p {
    font-size: 16px;
    line-height: 1.5;
  }

  /* timeline */
  .timeline {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
  }

  .timeline li {
    flex: 1 1 170px;
    min-width: 0;
    border-top: var(--rule-frame) solid var(--ink);
    padding-top: 12px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: 17px;
  }

  .timeline li.next {
    border-top-style: dashed;
  }

  .timeline .when {
    font-weight: 700;
    font-size: 16px;
    letter-spacing: 0.06em;
  }

  /* about */
  .about {
    padding-block: clamp(40px, 7vw, 80px);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 48px;
  }

  /* The drawing sits on a paper panel with the label's double frame. */
  .portrait {
    flex: 1 1 280px;
    max-width: 440px;
    min-width: 0;
    margin: 0;
    background: var(--paper);
    border: var(--rule-frame) solid var(--paper);
    padding: 8px;
  }

  .portrait-inner {
    border: var(--rule-fine) solid var(--ink);
    padding: 6px;
  }

  .portrait img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .about-copy {
    flex: 1 1 380px;
    min-width: 0;
    gap: 20px;
  }

  .about-copy h2 {
    margin-bottom: 4px;
  }

  /* The closing line, set like the batch ribbon: between two fine rules. */
  .pull {
    border-block: var(--rule-fine) solid var(--paper);
    padding: 10px 0;
    font-weight: 700;
  }

  /* label maker call to action */
  .cta-wrap {
    padding-bottom: clamp(32px, 6vw, 72px);
  }

  .cta-wrap--after-band {
    padding-top: clamp(32px, 6vw, 72px);
  }

  .cta {
    border-block: var(--rule-frame) solid var(--ink);
    padding: 32px 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .cta-copy {
    flex: 1 1 320px;
    min-width: 0;
    gap: 8px;
  }

  .cta-title {
    font-size: clamp(26px, 3.4vw, 38px);
    line-height: 1.15;
  }
</style>
