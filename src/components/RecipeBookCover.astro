---
/** The recipe book's cover: a paper panel with the label's double frame. */
---

<div class="cover">
  <div class="inner">
    <p class="brand">OLD MA MAIN'S</p>
    <p class="title">RECIPE<br />BOOK</p>
    <p class="fell tag">SMALL BATCH &bull; MADE WITH LOVE</p>
  </div>
</div>

<style>
  .cover {
    aspect-ratio: 5 / 7;
    background: var(--paper);
    color: var(--ink);
    border: var(--rule-frame) solid var(--paper);
    padding: 8px;
  }

  .inner {
    height: 100%;
    border: var(--rule-fine) solid var(--ink);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    text-align: center;
    padding: 16px;
  }

  .brand {
    font-weight: 700;
    font-size: 20px;
    letter-spacing: 0.02em;
    line-height: 1.2;
  }

  .title {
    font-weight: 700;
    font-size: 36px;
    line-height: 1.08;
  }

  .tag {
    font-size: 13px;
  }
</style>
